{
    "name": "@leafer-free/board",
    "version": "0.0.1",
    "description": "Vue 3 + Leafer.js 自由画板：可编辑画板与渲染预览，插件化扩展，快照驱动",
    "keywords": [
        "leafer",
        "leaferjs",
        "whiteboard",
        "canvas",
        "vue3",
        "mind-map",
        "diagram"
    ],
    "homepage": "https://github.com/ZekoFront/leafer-free-board#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ZekoFront/leafer-free-board.git"
    },
    "bugs": {
        "url": "https://github.com/ZekoFront/leafer-free-board/issues"
    },
    "license": "MIT",
    "author": "ZekoFront",
    "type": "module",
    "private": true,
    "sideEffects": [
        "*.css",
        "*.scss",
        "**/*.vue"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./editor": {
            "types": "./dist/engine/edit/EditorCanvas.vue.d.ts",
            "import": "./dist/engine/edit/EditorCanvas.vue"
        },
        "./render": {
            "types": "./dist/engine/render/RenderCanvas.vue.d.ts",
            "import": "./dist/engine/render/RenderCanvas.vue"
        },
        "./plugins": {
            "types": "./dist/plugins/index.d.ts",
            "import": "./dist/plugins/index.js"
        },
        "./styles": "./dist/styles/index.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "build:lib": "vue-tsc -b && vite build --mode lib",
        "preview": "vite preview",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "peerDependencies": {
        "leafer-ui": "^2.0.0",
        "pinia": "^3.0.0",
        "vue": "^3.5.0"
    },
    "dependencies": {
        "@leafer-in/arrow": "^2.0.2",
        "@leafer-in/editor": "^2.0.2",
        "@leafer-in/export": "^2.0.2",
        "@leafer-in/find": "^2.0.2",
        "@leafer-in/flow": "^2.0.2",
        "@leafer-in/resize": "^2.0.2",
        "@leafer-in/scroll": "^2.0.2",
        "@leafer-in/state": "^2.0.2",
        "@leafer-in/text-editor": "^2.0.2",
        "@leafer-in/view": "^2.0.2",
        "@leafer-in/viewport": "^2.0.2",
        "@leafer-ui/core": "^2.0.2",
        "@leafer-ui/draw": "^2.0.2",
        "@leafer-ui/interface": "^2.0.2",
        "@leafer/core": "^2.0.2",
        "@vueuse/core": "^13.9.0",
        "decimal.js": "^10.6.0",
        "events": "^3.3.0",
        "hotkeys-js": "^3.13.15",
        "leafer-ui": "^2.0.2",
        "leafer-x-dot-matrix": "^1.0.2",
        "leafer-x-easy-snap": "^1.11.0",
        "lodash-es": "^4.17.21",
        "lz-string": "^1.5.0",
        "naive-ui": "^2.43.2",
        "pinia": "^3.0.3",
        "uuid": "^13.0.0",
        "vue": "^3.5.22"
    },
    "devDependencies": {
        "@types/events": "^3.0.3",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^24.6.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.8.1",
        "oxfmt": "^0.35.0",
        "sass": "^1.93.2",
        "typescript": "~5.9.3",
        "unplugin-auto-import": "^20.2.0",
        "unplugin-vue-components": "^29.1.0",
        "vite": "^8.0.0",
        "vite-plugin-dts": "^5.0.3",
        "vite-svg-loader": "^5.1.0",
        "vue-tsc": "^3.1.0"
    },
    "engines": {
        "node": ">=18"
    }
}
